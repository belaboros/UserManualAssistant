flowchart LR
    Q["Question"] --> E["Local embedder"]
    Q --> B["FTS5 BM25"]
    DB[("SQLite chunks")] --> E
    DB --> B
    E -->|"30 vector candidates"| R["RRF fusion<br/>k = 60"]
    B -->|"30 keyword candidates"| R
    R -->|"ranked chunks"| V["Coverage rule<br/>top-k plus best chunk of each manual<br/>scoring at least 50 percent of the top"]
    V -->|"top-k chunks"| T["Retrieval trace event"]
    V -->|"top-k chunks as documents,<br/>then the question"| C["Claude"]
    C -->|"answer text, citations,<br/>status tag"| F["Status filter and<br/>citation resolver"]
    T -->|"retrieved chunks"| UI["Web UI"]
    F -->|"answer with [n] citations,<br/>status"| UI
